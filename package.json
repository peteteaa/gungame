{
  "name": "webgun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WebGun - browser Gun Game FPS (Three.js + Socket.io)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server/server.js & vite",
